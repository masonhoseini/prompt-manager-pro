{
  "manifest_version": 3,
  "name": "Prompt Manager Pro",
  "version": "2.0.0",
  "description": "Professional prompt management tool for ChatGPT, Claude, and other AI platforms",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}